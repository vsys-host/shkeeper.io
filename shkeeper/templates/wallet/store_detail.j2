{% extends 'wallet/page.j2' %}
{% import 'macros.j2' as ui %}

{% block content %}
<div class="content-container overflow-auto">
  {{ ui.flash_alerts() }}
  <h1 class="title-text">Store: {{ store.name }}</h1>

  <section class="mb-5">
    <h2 class="subtitle-text mb-3">Store settings</h2>
    {% if not store.is_default %}
    <form method="post" action="{{ url_for('wallet.store_update', store_id=store.id) }}" class="row g-3 align-items-end common-text mb-3">
      <div class="col-md-4">
        <label class="form-label" for="store-name">Name</label>
        <input id="store-name" class="form-control common-text" name="name" value="{{ store.name }}" required>
      </div>
      <div class="col-md-3">
        <label class="form-label" for="store-fee">Platform fee %</label>
        <input id="store-fee" class="form-control common-text" name="platform_fee_percent" type="number" min="0" step="0.01" value="{{ '%.2f'|format(store.platform_fee_percent) }}">
      </div>
      <div class="col-md-2">
        <button class="btn btn-outline-primary btn-outline-primary__customization" type="submit">Save</button>
      </div>
    </form>
    {% endif %}
    <p class="common-text mb-2">API key: <span class="courier-font functional-text">{{ store.api_key }}</span></p>
    <p class="common-text mb-3">
      Status:
      <span class="{% if store.status.name == 'ACTIVE' %}success-text{% elif store.status.name == 'SUSPENDED' %}warning-text{% else %}danger-text{% endif %}">
        {{ store.status.name }}
      </span>
    </p>
    {% if not store.is_default %}
    <div class="d-flex flex-wrap gap-2">
      {% if store.status.name == 'ACTIVE' %}
      <form method="post" action="{{ url_for('wallet.store_set_status', store_id=store.id) }}">
        <input type="hidden" name="action" value="suspend">
        <button class="btn btn-sm btn-outline-secondary btn-outline-secondary__customization" type="submit">Suspend</button>
      </form>
      {% elif store.status.name == 'SUSPENDED' %}
      <form method="post" action="{{ url_for('wallet.store_set_status', store_id=store.id) }}">
        <input type="hidden" name="action" value="activate">
        <button class="btn btn-sm btn-outline-primary btn-outline-primary__customization" type="submit">Activate</button>
      </form>
      {% endif %}
      <form method="post" action="{{ url_for('wallet.store_set_status', store_id=store.id) }}" onsubmit="return confirm('Soft-delete this store? It will disappear from the list.');">
        <input type="hidden" name="action" value="delete">
        <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
      </form>
    </div>
    {% endif %}
  </section>

  <section class="mb-5">
    <h2 class="subtitle-text mb-3">Store owner accounts</h2>
    {% if store_users %}
    <ul class="common-text mb-3">
      {% for user in store_users %}
      <li><span class="courier-font functional-text">{{ user.username }}</span></li>
      {% endfor %}
    </ul>
    {% else %}
    <p class="common-text mb-3">No store owner users yet.</p>
    {% endif %}
    {% if store.is_default %}
    <p class="common-text warning-text mb-3">
      Default store is for the admin only. Create a separate store for merchants before adding store owners.
    </p>
    {% elif store_users|length == 0 %}
    <h3 class="subtitle-text mb-2" style="font-size: 16px;">Add user</h3>
    <form method="post" action="{{ url_for('wallet.store_create_owner', store_id=store.id) }}" class="row g-2 common-text">
      <div class="col-md-3">
        <input class="form-control common-text" name="username" placeholder="Username" required>
      </div>
      <div class="col-md-3">
        <input class="form-control common-text" name="password" type="password" placeholder="Password" required>
      </div>
      <div class="col-md-2">
        <button class="btn btn-outline-secondary btn-outline-secondary__customization" type="submit">Create user</button>
      </div>
    </form>
    {% endif %}
  </section>

  <section class="mb-4">
    <h2 class="subtitle-text mb-3">Wallets</h2>
    {% if store_wallets %}
    <div class="store-wallets-list">
      {% for sw in store_wallets %}
      <form
        method="post"
        action="{{ url_for('wallet.store_wallet_update', store_id=store.id, wallet_id=sw.id) }}"
        class="store-wallet-card"
      >
        <div class="store-wallet-card__header">
          <strong class="common-text">{{ sw.crypto }}</strong>
          <span class="common-text {% if sw.status.name == 'READY' %}success-text{% elif sw.status.name == 'FAILED' %}danger-text{% else %}warning-text{% endif %}">
            {{ sw.status.name }}
          </span>
          <span class="common-text">Balance: {{ balances.get(sw.crypto) | default('—') }}</span>
        </div>

        {% if sw.last_error %}
        <p class="common-text danger-text mb-2"><small>{{ sw.last_error }}</small></p>
        {% endif %}

        <div class="store-wallet-card__row">
          <label class="table-subtitle" for="fda-{{ sw.id }}">FDA address</label>
          <div id="fda-{{ sw.id }}" class="store-wallet-card__address courier-font">{{ sw.fda_address or '—' }}</div>
        </div>

        {% if not store.is_default %}
        <div class="store-wallet-card__row">
          <label class="table-subtitle" for="cold-wallet-{{ sw.id }}">Cold wallet</label>
          <input
            id="cold-wallet-{{ sw.id }}"
            class="form-control common-text courier-font store-wallet-card__input"
            name="cold_wallet_address"
            value="{{ sw.cold_wallet_address or '' }}"
            placeholder="0x… merchant payout destination"
            spellcheck="false"
            autocomplete="off"
          >
        </div>

        <div class="store-wallet-card__row">
          <label class="table-subtitle" for="fee-collection-{{ sw.id }}">Fee collection</label>
          <input
            id="fee-collection-{{ sw.id }}"
            class="form-control common-text courier-font store-wallet-card__input"
            name="fee_collection_address"
            value="{{ sw.fee_collection_address or '' }}"
            placeholder="0x… external or FDA"
            spellcheck="false"
            autocomplete="off"
          >
        </div>

        <div class="store-wallet-card__footer">
          <div class="store-wallet-card__fee">
            <label class="table-subtitle" for="fee-override-{{ sw.id }}">Fee % override</label>
            <input
              id="fee-override-{{ sw.id }}"
              class="form-control common-text"
              name="fee_percent_override"
              type="number"
              min="0"
              step="0.01"
              value="{{ '%.2f'|format(sw.fee_percent_override) if sw.fee_percent_override is not none else '' }}"
              placeholder="%"
            >
          </div>
          <div class="store-wallet-card__actions">
            <button class="btn btn-sm btn-outline-primary btn-outline-primary__customization" type="submit">Save</button>
            {% if sw.status.name == 'FAILED' or sw.status.name == 'PENDING' %}
            <button
              class="btn btn-sm btn-outline-secondary btn-outline-secondary__customization"
              type="submit"
              formaction="{{ url_for('wallet.store_wallet_retry', store_id=store.id, crypto=sw.crypto) }}"
              formmethod="post"
            >Retry</button>
            {% endif %}
          </div>
        </div>
        {% elif sw.status.name == 'FAILED' or sw.status.name == 'PENDING' %}
        <div class="store-wallet-card__actions">
          <button
            class="btn btn-sm btn-outline-secondary btn-outline-secondary__customization"
            type="submit"
            formaction="{{ url_for('wallet.store_wallet_retry', store_id=store.id, crypto=sw.crypto) }}"
            formmethod="post"
          >Retry</button>
        </div>
        {% endif %}
      </form>
      {% endfor %}
    </div>
    {% else %}
    <p class="common-text">No wallets provisioned yet.</p>
    {% endif %}
  </section>

  <p class="common-text"><a href="{{ url_for('wallet.stores') }}" class="accent-text">← Back to stores</a></p>
</div>
{% endblock %}
