{% extends 'wallet/page.j2' %}
{% import 'macros.j2' as ui %}

{% block content %}
<div class="content-container overflow-auto">
  {{ ui.flash_alerts() }}
  <h1 class="title-text">Stores</h1>

  <section class="mb-5">
    <h2 class="subtitle-text mb-3">Create store</h2>
    <form method="post" action="{{ url_for('wallet.stores_create') }}" class="row g-3 align-items-end common-text">
      <div class="col-md-3">
        <label for="store-name" class="form-label">Store name</label>
        <input id="store-name" class="form-control common-text" name="name" placeholder="My store" required>
      </div>
      <div class="col-md-2">
        <label for="store-commission" class="form-label">Store commission, %</label>
        <input id="store-commission" class="form-control common-text" name="platform_fee_percent" type="number" min="0" step="0.01" value="0">
      </div>
      <div class="col-md-2">
        <button class="btn btn-outline-primary btn-outline-primary__customization" type="submit">Create</button>
      </div>
    </form>
  </section>

  <section class="mb-5">
    <h2 class="subtitle-text mb-3">Global fee collection addresses</h2>
    <p class="common-text mb-3">
      Fallback address used when a store has no per-coin fee collection override.
      Must be an external wallet or a fee-deposit (FDA) address — not a generated invoice address.
    </p>
    <form method="post" action="{{ url_for('wallet.stores_global_fee_collection') }}" class="common-text">
      <div class="row g-3">
        {% for crypto in multistore_cryptos %}
        <div class="col-md-6">
          <label class="form-label" for="fee_collection_{{ crypto }}">{{ crypto }}</label>
          <input
            id="fee_collection_{{ crypto }}"
            class="form-control common-text courier-font"
            name="fee_collection_{{ crypto }}"
            value="{{ global_fee_collection.get(crypto) or '' }}"
            placeholder="0x… external or FDA"
            spellcheck="false"
            autocomplete="off"
          >
        </div>
        {% else %}
        <p class="common-text">No multistore cryptos enabled.</p>
        {% endfor %}
      </div>
      {% if multistore_cryptos %}
      <button class="btn btn-outline-primary btn-outline-primary__customization mt-3" type="submit">Save global addresses</button>
      {% endif %}
    </form>
  </section>

  <section>
    <h2 class="subtitle-text mb-3">All stores</h2>
    <table class="transactions-data-table w-100 common-text">
      <thead>
        <tr>
          <th class="table-subtitle">ID</th>
          <th class="table-subtitle">Name</th>
          <th class="table-subtitle">Status</th>
          <th class="table-subtitle">Store commission %</th>
          <th class="table-subtitle">API key</th>
          <th class="table-subtitle">Balances</th>
          <th class="table-subtitle"></th>
        </tr>
      </thead>
      <tbody>
        {% for store in stores %}
        <tr>
          <td>{{ store.id }}</td>
          <td>{{ store.name }}{% if store.is_default %} <span class="accent-text">(default)</span>{% endif %}</td>
          <td class="{% if store.status.name == 'ACTIVE' %}success-text{% elif store.status.name == 'SUSPENDED' %}warning-text{% else %}danger-text{% endif %}">
            {{ store.status.name }}
          </td>
          <td>{{ '%.2f'|format(store.platform_fee_percent) }}</td>
          <td class="courier-font functional-text">{{ store.api_key }}</td>
          <td>
            {% for crypto, balance in store_balances.get(store.id, {}).items() %}
              <div>{{ crypto }}: {{ balance | default('—') }}</div>
            {% endfor %}
          </td>
          <td>
            <a href="{{ url_for('wallet.store_detail', store_id=store.id) }}" class="accent-text">Configure</a>
          </td>
        </tr>
        {% else %}
        <tr>
          <td colspan="7">No stores yet.</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>
</div>
{% endblock %}
